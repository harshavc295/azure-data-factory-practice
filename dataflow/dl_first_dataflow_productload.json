{
	"name": "dl_first_dataflow_productload",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_readtheProduct_DataFlow",
						"type": "DatasetReference"
					},
					"name": "readtheproductfile"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_adls_customer",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "RemoveLast3rows"
				},
				{
					"name": "AddBlackColorFlagColumn"
				},
				{
					"name": "filter"
				},
				{
					"name": "aggregate"
				},
				{
					"name": "sort"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ProductID as short,",
				"          Name as string,",
				"          ProductNumber as string,",
				"          Color as string,",
				"          StandardCost as double,",
				"          ListPrice as double,",
				"          Size as string,",
				"          Weight as double,",
				"          ProductCategoryID as short,",
				"          ProductModelID as short,",
				"          SellStartDate as string,",
				"          SellEndDate as string,",
				"          DiscontinuedDate as string,",
				"          ThumbNailPhoto as string,",
				"          ThumbnailPhotoFileName as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> readtheproductfile",
				"readtheproductfile select(mapColumn(",
				"          ProductID,",
				"          Name,",
				"          ProductNumber,",
				"          Color,",
				"          StandardCost,",
				"          ListPrice,",
				"          Size,",
				"          Weight,",
				"          ProductCategoryID,",
				"          ProductModelID,",
				"          SellStartDate,",
				"          SellEndDate,",
				"          DiscontinuedDate,",
				"          ModifiedDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveLast3rows",
				"RemoveLast3rows derive(BlackColorFlag = Color=='Black') ~> AddBlackColorFlagColumn",
				"AddBlackColorFlagColumn filter(ProductID>100) ~> filter",
				"filter aggregate(groupBy(Color),",
				"     StandardCost = max(StandardCost),",
				"          Weight = min(Weight)) ~> aggregate",
				"aggregate sort(asc(StandardCost, true)) ~> sort",
				"sort sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink"
			]
		}
	}
}